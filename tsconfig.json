{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true, "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "skipLibCheck": true, "noEmit": true, "types": ["node"],
    "baseUrl": ".", "paths": { "@shared/*": ["src/shared/*"], "@app/*": ["src/app/*"] }
  },
  "include": ["src/**/*", "tests/**/*", "vite.config.ts"]
}
